<?xml version="1.0" encoding="utf-8"?>
<!-- NEWTUBE(app-icon): the Glass launcher icon (Settings > Appearance > App icon), the default:
     the shaded red circle on dark glass. Drawn from the artwork's SVG (filters and all), so its
     layers are bitmaps. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_glass_background" />
    <foreground android:drawable="@drawable/ic_launcher_glass_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
