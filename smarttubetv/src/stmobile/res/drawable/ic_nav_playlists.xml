<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube-style nav icon: filled when the tab is selected, outline otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="220"
    android:exitFadeDuration="220">
    <item android:drawable="@drawable/ic_nav_playlists_fill" android:state_checked="true" />
    <item android:drawable="@drawable/ic_nav_playlists_outline" />
</selector>
